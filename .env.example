# Configuração do servidor local (docs/architecture/ai-integration.md §3).
# Copie para .env e preencha. O .env fica fora do git; a chave nunca chega ao
# navegador, a logs ou ao git (ADR 0015). Variáveis já definidas no ambiente vencem.

# Chave da sua conta do OpenRouter (obrigatória só para usar a IA).
OPENROUTER_API_KEY=

# Modelos por papel: SOM (decisões tipadas) e modelo de texto (falas).
AI_SOM_MODEL=typesafe/jev-1.14
AI_TEXT_MODEL=xiaomi/mimo-v2.6-pro

# Variedade das falas e esforço de raciocínio (vazio = desligado).
AI_TEXT_TEMPERATURE=0.8
AI_TEXT_REASONING_EFFORT=

# Tempo máximo por chamada, em milissegundos.
AI_TIMEOUT_MS=15000

# Teto de custo por conversa, em dólares (vazio = definido depois de medir 5 cenas, D-23).
AI_BUDGET_USD_PER_CONVERSATION=

# Porta do servidor local; ele escuta sempre em 127.0.0.1.
PORT=4318
