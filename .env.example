# Configuração do servidor local (docs/architecture/ai-integration.md §3 e
# docs/architecture/overview.md §5.3). Copie para .env e preencha só o que quiser mudar.
# O .env fica fora do git; a chave nunca chega ao navegador, a logs ou ao git (ADR 0015).
# Variáveis já definidas no ambiente vencem. Valor vazio = valor padrão. Valor inválido:
# o servidor não sobe e mostra "Erro: … — Solução: …".

# Chave da sua conta do OpenRouter (obrigatória só para usar a IA).
OPENROUTER_API_KEY=

# Modelos por papel: SOM (decisões tipadas) e modelo de texto (falas). Ids sem espaços.
AI_SOM_MODEL=typesafe/jev-1.14
AI_TEXT_MODEL=xiaomi/mimo-v2.6-pro

# Variedade das falas (número de 0 a 2) e esforço de raciocínio (low, medium ou high;
# vazio = desligado).
AI_TEXT_TEMPERATURE=0.8
AI_TEXT_REASONING_EFFORT=

# Tempo máximo por chamada, em milissegundos (inteiro de 1 a 2147483647).
AI_TIMEOUT_MS=15000

# Teto de custo por conversa, em dólares (número maior que 0; vazio = sem teto até medir
# 5 cenas, D-23).
AI_BUDGET_USD_PER_CONVERSATION=

# Porta do servidor local (0 a 65535); ele escuta sempre em 127.0.0.1.
PORT=4318

# Pasta das campanhas e fatias gravadas (vazio = data/ na raiz do repositório, fora do git;
# um caminho relativo parte da raiz do repositório).
DATA_DIR=

# Limites de tamanho do corpo dos pedidos, em bytes: o geral (1 MiB) e o das gravações de
# campanha e fatia (32 MiB). Acima do limite, o servidor responde 413.
BODY_LIMIT_BYTES=1048576
SESSION_BODY_LIMIT_BYTES=33554432

# Nível do log do servidor (JSON no stdout): fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info
