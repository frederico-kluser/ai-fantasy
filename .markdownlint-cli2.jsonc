{
  // Configuração do markdownlint-cli2 para o ai-fantasy.
  // `config` espelha .markdownlint.json (mantido para editores e outras ferramentas);
  // `ignores` exclui o que não é documentação nossa (conteúdo gerido e fontes históricas).
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD029": { "style": "ordered" },
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD046": { "style": "fenced" }
  },
  "ignores": [
    ".agents/**",
    ".claude/**",
    ".github/ISSUE_TEMPLATE/**",
    ".work/**",
    "node_modules/**",
    "target/**",
    "coverage/**",
    "mutants.out/**",
    "docs/architecture/assets/**",
    "Roadmap Jogo Procedural Com LFM3.md",
    "CHANGELOG.md"
  ]
}
