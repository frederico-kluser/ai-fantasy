{
  // Configuração do markdownlint-cli2 para o ai-fantasy.
  // `config` espelha .markdownlint.json (mantido para editores e outras ferramentas);
  // `ignores` exclui o que não é documentação nossa (conteúdo gerido, fontes históricas,
  // dependências e saídas geradas pelas ferramentas).
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD029": { "style": "ordered" },
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD046": { "style": "fenced" }
  },
  "ignores": [
    ".agents/**",
    ".claude/**",
    ".github/ISSUE_TEMPLATE/**",
    ".work/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/reports/**",
    "**/dist/**",
    "**/.stryker-tmp/**",
    "**/.vitest/**",
    "playwright-report/**",
    "test-results/**",
    "docs/studies/Avaliação e Arquitetura AI Fantasy.md",
    "docs/studies/Expansão Sistêmica Do AI Fantasy.md",
    "docs/studies/Original - Roadmap Jogo Procedural Com LFM3.md",
    "CHANGELOG.md"
  ]
}
