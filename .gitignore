# ---------------------------------------------------------------------------
# ai-fantasy — artefatos locais que NUNCA entram no repositório
# Regra: o repositório é código + documentos. Chaves, sessões gravadas e dados
# de execução ficam na máquina de cada pessoa (ver docs/architecture/ai-integration.md).
# ---------------------------------------------------------------------------

# Build e ferramentas do monorepo TypeScript
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
/reports/
.stryker-tmp/
/playwright-report/
/blob-report/

# Rust/WebAssembly (só se a tarefa PERF-01 for ativada)
/target/

# Modelos de IA (arquivos grandes, licenças próprias — nunca versionar)
/models/
**/*.gguf
**/*.safetensors
**/*.onnx
**/*.mlx
**/*.bin
**/mmproj-*

# Campanhas, sessões gravadas e telemetria local
/data/
/saves/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.log

# Áreas de trabalho e temporários
/.work/
/.tmp/
/tmp/
/scratch/

# Segredos e configuração local
.env
.env.*
!.env.example
*.pem
*.key

# Cobertura, mutação e relatórios
/coverage/
/lcov.info
/test-results/

# Ferramentas e sistemas
__pycache__/
*.py[cod]
.venv/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
